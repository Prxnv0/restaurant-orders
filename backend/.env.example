# Database (Supabase PostgreSQL)
# Get this from Supabase: Project Settings -> Database -> Connection string -> "Transaction" mode
# Use the same connection string for dev and prod; dev points to dev project, prod to prod project.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Alternative "direct" connection (Supabase session mode, port 5432) for migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWT secret (generate a random 64+ char string in production)
JWT_SECRET="change-me-in-production-please-this-is-not-secure"

# Slow-order alert threshold in minutes (default 15 per requirements)
ALERT_THRESHOLD_MINUTES=15

# Application timezone (used for "today" boundaries in dashboard and CSV)
APP_TIMEZONE="UTC"

# Server port
PORT=4000

# Frontend origin (for CORS in production)
FRONTEND_ORIGIN="http://localhost:5173"
