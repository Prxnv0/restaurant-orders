# dependencies
node_modules/
**/node_modules/

# build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# env files (NEVER commit secrets)
.env
.env.local
.env.*.local
backend/.env
backend/tests/.env
**/.env

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# prisma artifacts
prisma/migrations/dev.db*
prisma/*.db
prisma/*.db-journal

# prisma migrations (generated by `prisma migrate dev`; regenerate from schema on a clean checkout)
prisma/migrations/
backend/prisma/migrations/

# prisma schema/seed copies (use root prisma/ instead)
backend/prisma/schema.prisma
backend/prisma/seed.js
